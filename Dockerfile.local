# Local development and testing environment with hot-reloading
FROM golang:1.18-alpine

WORKDIR /app

RUN apk add --no-cache git curl ca-certificates bash build-base tzdata

# Install cosmtrek/air for hot reload during local development
RUN go install github.com/cosmtrek/air@v1.40.4

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG PORT=9876
ENV PORT=${PORT}
EXPOSE ${PORT}

CMD ["air", "-c", ".air.toml"]
